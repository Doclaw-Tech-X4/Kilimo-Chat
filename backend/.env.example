# =============================================================================
# KilimoChat Backend Environment Template
# Copy this file to backend/.env and fill in the real values:
#   cp backend/.env.example backend/.env
# =============================================================================

# Application
APP_NAME=KilimoChat
DEBUG=true
VOICE_MAX_AGE_HOURS=24
VOICE_MAX_FILES=100

# AI - Groq (chat fallback + Whisper transcription)
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# AI - Google Gemini (chat + image/video analysis)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-3.1-pro-preview
GEMINI_FREE_MODEL=gemini-2.5-flash
AI_PAID_TIER_ENABLED=false

# WhatsApp - Twilio
# https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Weather - OpenWeatherMap
# https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Database - MongoDB Atlas (required for user accounts)
# https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/kilimochat?retryWrites=true&w=majority
MONGODB_DB_NAME=kilimochat

# Authentication
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=your_jwt_secret_here
FRONTEND_URL=http://localhost:3000

# Email (SMTP) - required for verification and password reset
EMAIL_SERVICE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Use a Google App Password, not your normal Gmail password.
SMTP_PASS=your_gmail_app_password_here
EMAIL_FROM=your_email@gmail.com

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Text-to-Speech - ElevenLabs (optional; requires AI_PAID_TIER_ENABLED=true)
ELEVENLABS_API_KEY=

# Security / Compliance (optional)
# Generate a valid key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
